# 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 값을 채우세요.
# cp .streamlit/secrets.toml.example .streamlit/secrets.toml  (또는 수동 복사)

APP_PASSWORD = "가족이함께쓰는비밀번호"

# Supabase Project Settings > API
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
# Settings > API > service_role (secret) — 절대 GitHub에 올리지 마세요
SUPABASE_KEY = "YOUR_SERVICE_ROLE_KEY"
